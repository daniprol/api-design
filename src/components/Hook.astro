---
/**
 * The opening "why should I care?" card of each lesson.
 */
interface Props {
  title?: string;
}
const { title = "Why should you care?" } = Astro.props;
---

<aside class="dojo-hook" aria-label={title}>
  <p class="dojo-hook__eyebrow"><span aria-hidden="true">🎯</span> <span class="dojo-hook__title">{title}</span></p>
  <div class="dojo-hook__body"><slot /></div>
</aside>
