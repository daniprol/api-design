---
/**
 * Index of every company rule cited on the site, built at build time by
 * scanning page sources for <Rule> tags, so it can't drift from the pages.
 */
import { guides, type GuideId } from "../data/guides";
import { findTopic } from "../data/guide";

interface Props {
  guide: GuideId;
}

const { guide: guideId } = Astro.props;
const guide = guides[guideId];
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");

const sources = import.meta.glob<string>("../content/docs/**/*.mdx", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Row {
  id: string;
  level: string;
  title: string;
  pages: { title: string; href: string; number: string }[];
}

const rows = new Map<string, Row>();
const attr = (tag: string, name: string) => new RegExp(`\\b${name}="([^"]*)"`).exec(tag)?.[1];

for (const [path, source] of Object.entries(sources)) {
  const topic = findTopic(path.replace(/^.*content\/docs\//, "").replace(/\.mdx$/, ""));
  if (!topic) continue;
  for (const [tag] of source.matchAll(/<Rule\s[^>]*>/g)) {
    if (attr(tag, "guide") !== guideId) continue;
    const ruleId = attr(tag, "id");
    if (!ruleId) continue;
    const row = rows.get(ruleId) ?? { id: ruleId, level: attr(tag, "level") ?? "", title: attr(tag, "title") ?? "", pages: [] };
    if (!row.pages.some((p) => p.number === topic.number)) {
      row.pages.push({ title: topic.title, number: topic.number, href: `${base}/${topic.id}/` });
    }
    rows.set(ruleId, row);
  }
}

const sorted = [...rows.values()].sort((a, b) => Number(a.id) - Number(b.id));
const levelClass = (level: string) => (level.startsWith("MUST") ? "must" : level.startsWith("SHOULD") ? "should" : "may");
---

<p class="fg-index-count">{sorted.length} {guide.short} rules are cited in the Guide.</p>
<table class="fg-rule-index">
  <thead>
    <tr>
      <th>Rule</th>
      <th>Level</th>
      <th>Title</th>
      <th>Discussed in</th>
    </tr>
  </thead>
  <tbody>
    {
      sorted.map((row) => (
        <tr id={`${guideId}-${row.id}`}>
          <td>
            <a href={guide.ruleUrl(row.id)} rel="noopener">
              #{row.id}
            </a>
          </td>
          <td>
            <span class={`fg-rule__level fg-rule__level--${levelClass(row.level)}`}>{row.level}</span>
          </td>
          <td>{row.title}</td>
          <td>
            {row.pages.map((p, i) => (
              <>
                {i > 0 && ", "}
                <a href={p.href}>
                  {p.number} {p.title}
                </a>
              </>
            ))}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
