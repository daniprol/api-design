---
/**
 * One company guideline as a single row:
 *   Zalando · MUST · Pluralize resource names · #134 ↗
 */
import { guides, type GuideId, type RuleLevel } from "../data/guides";

interface Props {
  guide: GuideId;
  id?: string | number;
  level?: RuleLevel;
  title: string;
}

const { guide: guideId, id, level, title } = Astro.props;
const guide = guides[guideId];
if (!guide) throw new Error(`Unknown guide "${guideId}"`);
const levelClass = level?.startsWith("MUST") ? "must" : level?.startsWith("SHOULD") ? "should" : "may";
---

<div class="fg-rule" data-guide={guide.short}>
  <span class="fg-rule__guide">{guide.short}</span>
  {level && <span class={`fg-rule__level fg-rule__level--${levelClass}`}>{level}</span>}
  <span class="fg-rule__title">{title}</span>
  {
    id && (
      <a class="fg-rule__id" href={guide.ruleUrl(String(id))} rel="noopener">
        #{id} ↗
      </a>
    )
  }
  {Astro.slots.has("default") && <div class="fg-rule__body"><slot /></div>}
</div>
