---
/**
 * Visual map of the whole course, with per-module progress.
 */
import { curriculum, lessons, totalMinutes } from "../data/curriculum";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const hours = Math.round((totalMinutes / 60) * 10) / 10;
---

<dojo-course-map class="dojo-map not-content">
  <div class="dojo-map__summary">
    <div>
      <p class="dojo-map__stat"><b>{curriculum.length}</b> modules</p>
      <p class="dojo-map__stat"><b>{lessons.length}</b> lessons</p>
      <p class="dojo-map__stat"><b>~{hours}h</b> of reading</p>
    </div>
    <div class="dojo-map__progress" aria-live="polite">
      <div class="dojo-map__bar"><span data-progress-bar style="width: 0%"></span></div>
      <p><span data-progress-count>0</span> / {lessons.length} lessons completed</p>
    </div>
  </div>

  <ol class="dojo-map__modules">
    {
      curriculum.map((module, m) => (
        <li class="dojo-module" style={`--module-color: ${module.color}`}>
          <div class="dojo-module__head">
            <span class="dojo-module__emoji" aria-hidden="true">
              {module.emoji}
            </span>
            <div>
              <p class="dojo-module__number">Module {m + 1}</p>
              <h3 class="dojo-module__title">{module.title}</h3>
            </div>
          </div>
          <p class="dojo-module__tagline">{module.tagline}</p>
          <ol class="dojo-module__lessons">
            {module.lessons.map((lesson) => {
              const id = `course/${module.slug}/${lesson.slug}`;
              return (
                <li data-lesson={id}>
                  <a href={`${base}/${id}/`}>
                    <span class="dojo-module__check" aria-hidden="true" />
                    <span class="dojo-module__lesson">{lesson.title}</span>
                    <span class="dojo-module__min">{lesson.minutes}′</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </li>
      ))
    }
  </ol>
</dojo-course-map>

<script>
  import { getDone, onProgress } from "../scripts/progress";

  class DojoCourseMap extends HTMLElement {
    connectedCallback() {
      this.render();
      onProgress(() => this.render());
    }

    render() {
      const done = getDone();
      const items = [...this.querySelectorAll<HTMLElement>("[data-lesson]")];
      let count = 0;
      for (const item of items) {
        const isDone = done.has(item.dataset.lesson ?? "");
        item.classList.toggle("is-done", isDone);
        if (isDone) count++;
      }
      const bar = this.querySelector<HTMLElement>("[data-progress-bar]");
      const label = this.querySelector<HTMLElement>("[data-progress-count]");
      if (bar) bar.style.width = `${items.length ? (count / items.length) * 100 : 0}%`;
      if (label) label.textContent = String(count);
    }
  }

  if (!customElements.get("dojo-course-map")) customElements.define("dojo-course-map", DojoCourseMap);
</script>
