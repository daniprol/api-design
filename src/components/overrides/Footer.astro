---
/**
 * Page footer: References and Related (from frontmatter), prev/next, edit link,
 * and the site line (licence, source, build date).
 */
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";
import { findTopic } from "../../data/guide";

const { entry, id } = Astro.locals.starlightRoute;
const { sources = [], related = [] } = entry.data as typeof entry.data & {
  sources?: { label: string; title: string; url: string; accessed?: string }[];
  related?: string[];
};
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const relatedTopics = related.map((r) => {
  const topic = findTopic(r);
  if (!topic) throw new Error(`Unknown related topic "${r}" on ${id}`);
  return topic;
});
const built = new Date().toISOString().slice(0, 10);
const isHome = id === "";
---

<footer class="fg-footer">
  {
    sources.length > 0 && (
      <section class="fg-refs" aria-labelledby="references">
        <h2 id="references">References</h2>
        <ol>
          {sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.title}
              </a>
              {s.accessed && <span class="fg-refs__accessed">Accessed {s.accessed}.</span>}
            </li>
          ))}
        </ol>
      </section>
    )
  }
  {
    relatedTopics.length > 0 && (
      <section class="fg-related" aria-labelledby="related">
        <h2 id="related">Related</h2>
        <ul>
          {relatedTopics.map((t) => (
            <li>
              <a href={`${base}/${t.id}/`}>
                <span class="fg-related__num">{t.number}</span> {t.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {!isHome && <Pagination />}
  <div class="fg-colophon">
    <p>
      Text <a href={`${base}/about/license/`}>CC BY 4.0</a>, code MIT ·{" "}
      <a href="https://github.com/daniprol/api-design">Source on GitHub</a> · Last build{" "}
      <time datetime={built}>{built}</time>
    </p>
    {!isHome && <EditLink />}
  </div>
</footer>

<script>
  // Print every fold expanded: closed <details> content isn't rendered otherwise.
  window.addEventListener("beforeprint", () => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>(".sl-markdown-content details")) d.open = true;
  });
</script>
