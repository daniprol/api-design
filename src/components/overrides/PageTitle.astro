---
/**
 * Title, one-sentence summary, then a metadata line:
 *   Last reviewed Nov 2026 · Sources: RFC 9110 §9.3, RFC 5789
 */
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { findTopic } from "../../data/guide";

const { entry, lastUpdated, id } = Astro.locals.starlightRoute;
const { description, sources = [] } = entry.data as typeof entry.data & {
  sources?: { label: string; url: string }[];
};
const topic = findTopic(id);
const reviewed = lastUpdated?.toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
const shown = sources.slice(0, 3);
---

{topic && <p class="fg-eyebrow">{topic.number} · {topic.section.title}</p>}
{id !== "" && <Default />}
{description && id !== "" && <p class="fg-summary">{description}</p>}
{
  (reviewed || shown.length > 0) && id !== "" && (
    <p class="fg-meta">
      {reviewed && (
        <span>
          Last reviewed <time datetime={lastUpdated?.toISOString()}>{reviewed}</time>
        </span>
      )}
      {shown.length > 0 && (
        <span>
          Sources:{" "}
          {shown.map((s, i) => (
            <>
              {i > 0 && ", "}
              <a href={s.url} rel="noopener">
                {s.label}
              </a>
            </>
          ))}
          {sources.length > shown.length && (
            <>
              ,{" "}
              <a href="#references">+{sources.length - shown.length} more</a>
            </>
          )}
        </span>
      )}
    </p>
  )
}
