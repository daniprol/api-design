---
/**
 * Adds a lesson header (module, position, reading time) above lesson titles.
 */
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { findLesson, lessons } from "../../data/curriculum";

const lesson = findLesson(Astro.locals.starlightRoute.id);
---

{
  lesson && (
    <div class="dojo-lesson-meta" style={`--module-color: ${lesson.module.color}`}>
      <span class="dojo-lesson-meta__module">
        {lesson.module.emoji} Module {lesson.moduleIndex + 1} · {lesson.module.title}
      </span>
      <span class="dojo-lesson-meta__chip">
        Lesson {lesson.number} / {lessons.length}
      </span>
      <span class="dojo-lesson-meta__chip">⏱ {lesson.minutes} min</span>
      <span class="dojo-lesson-meta__chip dojo-lesson-meta__done" data-lesson-done hidden>
        ✓ Completed
      </span>
    </div>
  )
}
<Default />

<script>
  import { decorateSidebar, getDone, hrefToId, onProgress } from "../../scripts/progress";

  const update = () => {
    decorateSidebar();
    const chip = document.querySelector<HTMLElement>("[data-lesson-done]");
    if (chip) chip.hidden = !getDone().has(hrefToId(location.href));
  };
  update();
  onProgress(update);
</script>
