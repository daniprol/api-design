---
/**
 * Fun facts, history and real-world stories.
 */
type Kind = "history" | "war-story" | "fun-fact" | "real-world";

interface Props {
  kind?: Kind;
  title?: string;
}

const meta: Record<Kind, { icon: string; label: string }> = {
  history: { icon: "📜", label: "A bit of history" },
  "war-story": { icon: "🔥", label: "War story" },
  "fun-fact": { icon: "🤓", label: "Fun fact" },
  "real-world": { icon: "🌍", label: "In the wild" },
};

const { kind = "fun-fact", title } = Astro.props;
const { icon, label } = meta[kind];
---

<aside class={`dojo-story dojo-story--${kind}`} aria-label={label}>
  <div class="dojo-story__icon" aria-hidden="true">{icon}</div>
  <div>
    <p class="dojo-story__label">{label}{title && <span> · {title}</span>}</p>
    <div class="dojo-story__body"><slot /></div>
  </div>
</aside>
