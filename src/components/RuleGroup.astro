---
/** Company guidelines relevant to the page, collapsed. The label is filled in from the rules inside. */
---

<details class="fg-fold fg-rules">
  <summary>
    <span class="fg-fold__title">Company guidelines</span>
    <span class="fg-fold__meta" data-rule-count></span>
  </summary>
  <div class="fg-fold__body"><slot /></div>
</details>

<script>
  for (const group of document.querySelectorAll<HTMLDetailsElement>(".fg-rules")) {
    const rules = [...group.querySelectorAll<HTMLElement>(".fg-rule")];
    const names = [...new Set(rules.map((r) => r.dataset.guide))].join(", ");
    const label = group.querySelector<HTMLElement>("[data-rule-count]");
    if (label) label.textContent = `${names} · ${rules.length} rule${rules.length === 1 ? "" : "s"}`;
  }
</script>
